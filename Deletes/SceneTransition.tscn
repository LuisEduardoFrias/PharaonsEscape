[gd_scene format=3 uid="uid://cauhamnaknipf"]

[sub_resource type="GDScript" id="GDScript_wf8f0"]
script/source = "extends CanvasLayer

func transition_to(target: String) -> void:
	var transition = get_tree().current_scene.get_node_or_null(\"/root/SceneTransition\") or get_tree().root.get_node_or_null(\"SceneTransition\")
	if transition:
		var anim = transition.get_node(\"AnimationPlayer\") as AnimationPlayer
		if anim:
			transition.visible = true
			anim.play(\"fade_to_black\")
			await anim.animation_finished
			get_tree().change_scene_to_file(target)
			anim.play_backwards(\"fade_to_black\")
			await anim.animation_finished
			transition.visible = false
	else:
		get_tree().change_scene_to_file(target)
"

[node name="SceneTransition" type="CanvasLayer" unique_id=835566156]
script = SubResource("GDScript_wf8f0")

